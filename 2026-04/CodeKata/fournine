#include <string>
#include <vector>
#include <set>
using namespace std;

vector<int> solution(vector<int> numbers) {
	set<int> _tmp;
	vector<int> answer;
	for (int i = 0; i < numbers.size(); i++) {
		for (int j = i + 1; j < numbers.size(); j++) {			
			_tmp.insert(numbers[i] + numbers[j]);
		}
	}
	answer.assign(_tmp.begin(), _tmp.end());
    return answer;
}